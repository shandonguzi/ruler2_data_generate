# 所有密钥与模型名只从本文件读取，不读取进程环境变量。
# 复制为 config/.env 后填写；缺少必填项时程序会报错退出。

# 搜索与正文提取 API Key（二选一，只填写 config/config.yaml 中 provider 对应的那一项）
# provider: tavily
SCOPECRAWL_TAVILY_API_KEY=
# provider: deepseek（DeepSeek 平台 Key，不是 LLM 网关的 Key）
SCOPECRAWL_DEEPSEEK_API_KEY=

# LLM 模型名（必填），任意兼容 /v1/chat/completions 的模型
SCOPECRAWL_LLM_MODEL=

# LLM API Key（必填）
SCOPECRAWL_LLM_API_KEY=

# LLM 接口地址（可选；留空使用 OpenAI 官方地址）
SCOPECRAWL_LLM_BASE_URL=
