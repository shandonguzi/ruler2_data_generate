# 虚拟环境与 Python 缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# 测试覆盖率
.coverage*
htmlcov/

# 密钥：只提交模板，不提交本地配置
config/.env
config/.env.*
!config/.env.example

# 生成数据与本地运行状态
data/
.history.json
*.log
.DS_Store

# 父仓库全局忽略 config.yaml，主配置需要入库，此处覆盖
!config/config.yaml
